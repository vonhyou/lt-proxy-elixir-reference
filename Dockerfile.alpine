ARG ELIXIR=1.20.4
ARG OTP=29.1.2
ARG ALPINE=3.24.2

FROM docker.io/hexpm/elixir:${ELIXIR}-erlang-${OTP}-alpine-${ALPINE} AS build

ENV MIX_ENV=prod
WORKDIR /app

RUN apk add --no-cache git && mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock ./
RUN mix deps.get --only prod
COPY config/config.exs config/prod.exs config/
RUN mix deps.compile && mix assets.setup

COPY lib lib
COPY priv priv
COPY assets assets
RUN mix compile && mix assets.deploy

COPY config/runtime.exs config/
RUN mix release

FROM docker.io/alpine:${ALPINE}

RUN apk add --no-cache ca-certificates libstdc++ ncurses-libs openssl lksctp-tools \
 && adduser -S -H -h /app app \
 && mkdir -p /app/data && chown app /app/data

# The release stays root-owned and read-only to the app; only /app/data is writable.
# Distribution is off: no epmd, no node port, and the build-time cookie is never used.
ENV LANG=C.UTF-8 LTP_ADMIN_BIND=0.0.0.0 RELEASE_DISTRIBUTION=none
WORKDIR /app
COPY --from=build /app/_build/prod/rel/lt_proxy ./
USER app

VOLUME /app/data
EXPOSE 5000 5001
HEALTHCHECK CMD wget -qO- "http://127.0.0.1:${LTP_PORT:-5000}/health" || exit 1
CMD ["bin/lt_proxy", "start"]
