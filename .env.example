# Provider API key; LTP_PROVIDER is openrouter (default), anthropic or openai
LTP_PROVIDER_KEY=
# Admin panel password (user "admin"), 16+ characters; create API keys there
LTP_ADMIN_PASSWORD=

# Optional. Model id, defaulted per provider; required for openai
# LTP_MODEL=
# Optional. API base URL, defaulted per provider; required for openai
# LTP_PROVIDER_URL=
# Optional. name:key pairs (24+ characters) when running without the admin panel
# LTP_API_KEYS=
# Optional. Hostnames you open the admin panel with; IP addresses are always allowed
# LTP_ADMIN_HOSTS=
